# This file defines the canonical (non-secret) defaults for every environment.
# Real secrets belong in .env.local (git-ignored) or the runtime environment.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_DEBUG=1
APP_SECRET=change_me_in_local_env
TRUSTED_PROXIES=127.0.0.1,REMOTE_ADDR
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="postgresql://app:app@127.0.0.1:5433/app?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Async domain events + webhook delivery travel through RabbitMQ.
MESSENGER_TRANSPORT_DSN=amqp://app:app@127.0.0.1:5672/%2f/messages
###< symfony/messenger ###

###> redis ###
REDIS_URL=redis://127.0.0.1:6379
###< redis ###

###> symfony/lock ###
# Distributed lock backend for wallet reconciliation runs.
LOCK_DSN=redis://127.0.0.1:6379
###< symfony/lock ###

###> app/crypto ###
# HMAC key used to sign outbound webhooks (rotate via a key set in production).
WEBHOOK_SIGNING_KEY=local_dev_webhook_key
# HMAC key inbound API clients use to sign requests.
API_REQUEST_SIGNING_KEY=local_dev_api_key
###< app/crypto ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost:8081
###< symfony/routing ###
