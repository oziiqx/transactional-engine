# Overrides applied only when APP_ENV=test. Loaded after .env, committed to VCS.

APP_DEBUG=1
APP_SECRET=test_secret

# The database name has "_test" appended automatically (doctrine.yaml, when@test),
# so tests never touch the development database. TEST_TOKEN isolates parallel runs.

# Messages are collected in memory, never really consumed.
MESSENGER_TRANSPORT_DSN=in-memory://
LOCK_DSN=in-memory

WEBHOOK_SIGNING_KEY=test_webhook_key
API_REQUEST_SIGNING_KEY=test_api_key

SYMFONY_DEPRECATIONS_HELPER=max[direct]=0
