# Overrides applied only when APP_ENV=test. Loaded after .env, committed to VCS.

APP_ENV=test
APP_DEBUG=0
APP_SECRET=test_secret

# The DAMA transaction wrapper rolls back after every test, so a single
# throwaway database is enough. TEST_TOKEN keeps parallel runners isolated.
DATABASE_URL="postgresql://app:app@127.0.0.1:5432/app_test?serverVersion=16&charset=utf8"

# In-memory transport: messages are collected, never really consumed.
MESSENGER_TRANSPORT_DSN=in-memory://

LOCK_DSN=in-memory
REDIS_URL=redis://127.0.0.1:6379

WEBHOOK_SIGNING_KEY=test_webhook_key
API_REQUEST_SIGNING_KEY=test_api_key

SYMFONY_DEPRECATIONS_HELPER=max[direct]=0
PANTHER_APP_ENV=panther
