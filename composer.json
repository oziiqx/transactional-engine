{
    "name": "oziiqx/transactional-engine",
    "description": "Multi-currency transactional engine — Domain-Driven Design, Hexagonal Architecture and CQRS on Symfony 7.4.",
    "type": "project",
    "license": "MIT",
    "keywords": ["ddd", "hexagonal", "cqrs", "symfony", "fintech", "event-driven"],
    "require": {
        "php": ">=8.3",
        "ext-bcmath": "*",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-json": "*",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*",
        "api-platform/core": "^4.3.18",
        "doctrine/dbal": "^4.4.4",
        "doctrine/doctrine-bundle": "^2.19.1",
        "doctrine/doctrine-migrations-bundle": "^3.7.1",
        "doctrine/orm": "^3.7",
        "nelmio/cors-bundle": "^2.6.1",
        "symfony/amqp-messenger": "7.4.*",
        "symfony/asset": "7.4.*",
        "symfony/clock": "7.4.*",
        "symfony/console": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/flex": "^2.11",
        "symfony/framework-bundle": "7.4.*",
        "symfony/lock": "7.4.*",
        "symfony/messenger": "7.4.*",
        "symfony/monolog-bundle": "^3.11.2",
        "symfony/property-access": "7.4.*",
        "symfony/property-info": "7.4.*",
        "symfony/rate-limiter": "7.4.*",
        "symfony/redis-messenger": "7.4.*",
        "symfony/runtime": "7.4.*",
        "symfony/serializer": "7.4.*",
        "symfony/twig-bundle": "7.4.*",
        "symfony/uid": "7.4.*",
        "symfony/validator": "7.4.*",
        "symfony/yaml": "7.4.*",
        "webonyx/graphql-php": "^15.21"
    },
    "require-dev": {
        "dama/doctrine-test-bundle": "^8.6",
        "pestphp/pest": "^3.8.7",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan": "^2.2.13",
        "phpstan/phpstan-doctrine": "^2.0.28",
        "phpstan/phpstan-phpunit": "^2.0.18",
        "phpstan/phpstan-strict-rules": "^2.0.12",
        "phpstan/phpstan-symfony": "^2.0.20",
        "rector/rector": "^2.6.6",
        "symfony/browser-kit": "7.4.*",
        "symfony/css-selector": "7.4.*",
        "symfony/maker-bundle": "^1.67",
        "symfony/phpunit-bridge": "^7.4.18",
        "symplify/easy-coding-standard": "^12.6.2",
        "zenstruck/foundry": "^2.12.1"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": ["@auto-scripts"],
        "post-update-cmd": ["@auto-scripts"],
        "cs": "ecs check",
        "cs:fix": "ecs check --fix",
        "phpstan": "phpstan analyse --memory-limit=-1",
        "rector": "rector process --dry-run",
        "test": "pest --colors=always",
        "test:unit": "pest --testsuite=unit",
        "test:integration": "pest --testsuite=integration --testsuite=functional",
        "qa": ["@cs", "@phpstan", "@test"]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.4.*"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
